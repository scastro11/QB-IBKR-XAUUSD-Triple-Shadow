# IBKR connection. Never commit real credentials or private network details.
RUNNER_IBKR_HOST=127.0.0.1
RUNNER_IBKR_PORT=7497
RUNNER_IBKR_CLIENT_ID=2461
RUNNER_IBKR_MARKET_DATA_TYPE=3

# Observer output
RUNNER_IBKR_OUTPUT_DIR=./runtime_data

# Optional telemetry: disabled by default in the public project.
RUNNER_C_TELEMETRY_ENABLED=0
OPERACIONES_REALES_URL=
OPERACIONES_REALES_TOKEN=
